# Shared environment contract for Kirov applications
# Copy to .env.local / .dev.vars with real values. NEVER commit real values.

# --- Cloudflare ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- API / Worker ---
API_BASE_URL=https://api.kirov.example.com
PUBLIC_SITE_URL=https://kirov.kirov.example.com

# --- D1 (bound via wrangler.toml; this shows names only) ---
# d1_databases = [{ binding = "DB", database_name = "kirov_db", database_id = "" }]
Wrangler bindings DB (see wrangler.toml.example)

# --- R2 ---
# r2_buckets = [{ binding = "STORAGE", bucket_name = "" }]
R2_ENDPOINT=

# --- Email (Resend or via EmailService) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=

# --- Analytics ---
UMAMI_HOST_URL=
UMAMI_WEBSITE_ID=
UMAMI_CUSTOM_DOMAIN=

# --- AI (provider abstraction) ---
AI_ENABLED=false
AI_PROVIDER=
AI_MODEL=
# AI_API_KEY=

# --- Feature flags & kill switches ---
FEATURE_AI_ASSISTANT=false
FEATURE_LIVE_TRACKING=false
FEATURE_PAYMENTS=false
FEATURE_DRIVER_APP=true
MAPS_ENABLED=false
SMS_ENABLED=false

# --- Quotas (per plan, enforced server-side) ---
PLAN_FREE_AI_QUOTA=5
PLAN_BUSINESS_AI_QUOTA=500
PLAN_FREE_BOOKING_QUOTA=10